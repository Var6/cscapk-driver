{
  "expo": {
    "name": "CSC Driver",
    "slug": "cscapk-driver",
    "scheme": "cscapkdriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.csctravels.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show nearby trips and guide you to pickups."
      }
    },
    "android": {
      "package": "com.csctravels.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CSC Driver to use your location to find nearby trips."
        }
      ]
    ],
    "extra": {
      "BILLING_URL": "https://app.csctravels.com",
      "IOS_GOOGLE_MAPS": false,
      "router": {},
      "eas": {
        "projectId": "4a682879-0d37-44da-bd77-2552a02ed69d"
      }
    },
    "owner": "rishabh_stark"
  }
}
